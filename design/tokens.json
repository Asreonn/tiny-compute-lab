    "bg": {
      "void": "#070D0C",
      "board": "#0C1614",
      "board-alt": "#0F1B18",
      "grid": "#15282A",
      "grid-major": "#1B3634",
      "trace": "#1E3A33"
    },
    "surface": {
      "panel": "#101C1A",
      "raised": "#162522",
      "sunken": "#0A1311",
      "border": "#243A36",
      "border-strong": "#35524C"
    },
    "text": {
      "primary": "#E4EFEB",
      "secondary": "#93ABA4",
      "muted": "#5E7771",
      "inverse": "#081110"
    },
    "machine": {
      "body": "#15221F",
      "body-hi": "#1C2D29",
      "frame": "#3A554E",
      "frame-hover": "#6A8C83",
      "screen": "#08110F",
      "rail": "#22352F"
    },
    "data": {
      "number": "#3EE0CF",
      "number-dim": "#1B5E57",
      "boolean": "#F46BD6",
      "boolean-dim": "#6A2D5D",
      "boolean-false": "#8A5A80"
    },
    "family": {
      "io": "#7DDC6F",
      "math": "#5AA2FF",
      "logic": "#A58BFF",
      "routing": "#F5D04A",
      "storage": "#FF9E5E",
      "compute": "#C9D4D0"
    },
    "state": {
      "select": "#EAF4FF",
      "hover": "#9BB8B0",
      "valid": "#57E389",
      "invalid": "#FF4D5E",
      "error": "#FF4D5E",
      "blocked": "#FFB020",
      "success": "#57E389",
      "running": "#57E389",
      "paused": "#FFB020",
      "build": "#5AA2FF"
    },
    "material": {
      "plate": "#1F302C",
      "plate-hi": "#2C433D",
      "plate-lo": "#172622",
      "frame": "#4A6961",
      "copper": "#C08A52",
      "copper-dim": "#5A432E",
      "gold": "#D9B45B",
      "vent": "#091210",
      "silk": "#CFE0DA",
      "die": "#0C1614"
    },
    "board": {
      "zone": "#0F1D1A",
      "zone-edge": "#16302A",
      "pad": "#12211E",
      "pad-edge": "#1F3A34",
      "silk": "#2A4841"
    }
  },
  "grid": {
    "tile": 64,
    "board-default": [
      20,
      12
    ]
  },
  "size": {
    "S": [
      1,
      1
    ],
    "M": [
      2,
      1
    ],
    "L": [
      2,
      2
    ],
    "shell-inset": 4,
    "port": 14,
    "port-hit": 24,
    "packet-near": [
      30,
      18
    ],
    "packet-far": 6,
    "wire": 6,
    "wire-core": 2,
    "packet-close": [
      30,
      16
    ],
    "packet-normal": [
      20,
      12
    ]
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "shell": 6,
    "panel": 6,
    "control": 4,
    "chip": 3,
    "packet": 9
  },
  "stroke": {
    "hair": 1,
    "frame": 2,
    "select": 2,
    "focus": 3
  },
  "font": {
    "family": "JetBrains Mono",
    "size": {
      "micro": 9,
      "caption": 11,
      "body": 13,
      "label": 12,
      "title": 16,
      "display": 28,
      "hero": 44
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700,
      "extrabold": 800
    }
  },
  "shadow": {
    "panel": "0 6 18 #00000080",
    "glow-number": "0 0 10 #3EE0CF88",
    "glow-boolean": "0 0 10 #F46BD688"
  },
  "motion": {
    "micro": 0.1,
    "hover": 0.14,
    "select": 0.15,
    "port-pulse": 0.16,
    "packet-enter": 0.12,
    "panel": 0.2,
    "complete": 0.45,
    "tick": 0.1,
    "ease": "out-cubic (Tween.TRANS_CUBIC, EASE_OUT); no bounce, no overshoot"
  },
  "zoom": {
    "far-below": 0.6,
    "close-above": 1.35,
    "$comment": "camera zoom thresholds for FAR / NORMAL / CLOSE information density"
  },
  "machine-space": {
    "$comment": "V2 refinement: internal machine layout grid. xs = chassis inset / related gap, s = min clearance between unrelated elements, m = content margin + port clearance half-width, l = gap between functional sections.",
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "port-clearance": 12,
    "deco-clearance": 8,
    "family-tab": [
      24,
      3
    ],
    "led": 12,
    "port-box": 24,
    "port-body": 14
  }
}