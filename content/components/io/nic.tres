[resource]
script = ExtResource("4_nic")
id = "nic"
display_name = "Network Module"
family = "io"
size = "X"
ticks = 1
campaign_ticks = 1
power = 0
heat = 0
max_lanes = 1
glyph_text = "NIC"
description = "The laptop's network card: moves records between remote sources and the factory under one frame budget (16 bits = 1 frame). It never reads the data."
ports = Array[ExtResource("3_nic")]([SubResource("Resource_nicr1"), SubResource("Resource_nicr2"), SubResource("Resource_nicr3"), SubResource("Resource_nicr4"), SubResource("Resource_nicr5")])
params = Array[ExtResource("2_nic")]([SubResource("Resource_nicp1"), SubResource("Resource_nicp2"), SubResource("Resource_nicp3"), SubResource("Resource_nicp4"), SubResource("Resource_nicp5"), SubResource("Resource_nicp6")])
logic = ExtResource("1_nic")
