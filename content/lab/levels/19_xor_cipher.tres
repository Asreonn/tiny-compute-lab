"accept_width": 8,
"count": 24,
"kind": "paired",
"ops": [{
"op": "encode_char",
"width": 8
}, {
"op": "xor_src",
"src": "key"
}],
"pair": ["text", "key"]
}
streams = {
"key": {
"values": [23, 5, 77, 61, 9, 88, 42, 14]
},
"text": {
"values": ["attackatdawn"]
}
}
