[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://core/content/level_def.gd" id="1_1m2br"]

[resource]
script = ExtResource("1_1m2br")
id = "lab_l24"
title = "Calculator"
brief = "Three sticks: a number, a second number on the key stick, and an operation bit. Add when it is 0, subtract when it is 1."
contract = {
"accept_format": "bits",
"accept_width": 5,
"count": 24,
"kind": "paired",
"ops": [{
"op": "encode_num",
"width": 5
}, {
"b": "key",
"op": "alu_src",
"ops": ["ADD", "SUB"],
"sel": "bits"
}],
"pair": ["number", "key", "bits"]
}
streams = {
"bit": {
"interval": 6,
"values": ["0", "1", "1", "0", "1"],
"width": 1
},
"key": {
"interval": 6,
"values": [4, 8, 2, 6, 1, 3]
},
"number": {
"interval": 6,
"values": [9, 3, 14, 7, 20, 5, 11]
}
}
devices = PackedStringArray()
unlocks = PackedStringArray("alu")
view = 1
