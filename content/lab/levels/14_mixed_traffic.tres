[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://core/content/level_def.gd" id="1_nw05m"]

[resource]
script = ExtResource("1_nw05m")
id = "lab_l14"
title = "Mixed Traffic"
brief = "Tagged words: when the top bit is set add 1 to the payload, otherwise double it. One output."
contract = {
"accept_format": "bits",
"accept_width": 3,
"count": 24,
"kind": "map",
"ops": [{
"bit": 4,
"else": [{
"len": 3,
"lo": 0,
"op": "slice"
}, {
"k": 2,
"op": "mul"
}],
"op": "if_bit",
"then": [{
"len": 3,
"lo": 0,
"op": "slice"
}, {
"k": 1,
"op": "add"
}]
}]
}
streams = {
"bit": {
"interval": 2,
"values": ["10011", "00101", "11110", "01010", "10001", "00111", "11100", "01011"],
"width": 5
}
}
devices = PackedStringArray()
unlocks = PackedStringArray("demux", "mux", "cond_router")
